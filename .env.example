# 模型网关地址（OpenAI 兼容格式）
LLM_BASE_URL=https://your-gateway-url/v1
# API 密钥
LLM_API_KEY=your-api-key
# 使用的模型名称
LLM_MODEL=your-model-name

# ===== 日报推送（均可选，不填则跳过） =====
# 飞书自定义机器人 Webhook（群设置 -> 群机器人 -> 添加自定义机器人）
LARK_WEBHOOK=

# 邮箱推送（以 QQ 邮箱为例：设置 -> 账户 -> 开启 SMTP 服务 -> 生成授权码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq@qq.com
SMTP_PASS=your-smtp-授权码
MAIL_TO=target@example.com
